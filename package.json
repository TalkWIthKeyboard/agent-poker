{
  "name": "agent-poker",
  "version": "0.6.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": [
    "install.mjs",
    "dist/poker"
  ],
  "bin": {
    "agent-poker": "./install.mjs",
    "poker": "./dist/poker/scripts/poker"
  },
  "scripts": {
    "build": "pnpm generate && pnpm build:web && pnpm build:skill",
    "build:skill": "rm -rf dist/poker dist/agent-poker-skill.zip && bun build cli/index.ts --target=bun --minify --outfile=dist/poker/scripts/poker && chmod +x dist/poker/scripts/poker && cp .agents/skills/poker/SKILL.md dist/poker/SKILL.md && (cd dist && zip -qr agent-poker-skill.zip poker)",
    "build:web": "vite build",
    "check": "pnpm generate && tsc --noEmit && vitest run",
    "dev": "pnpm generate && pnpm build:web && wrangler dev",
    "dev:web": "pnpm generate && vite dev",
    "deploy": "pnpm build && wrangler deploy",
    "generate": "buf generate",
    "preview": "pnpm generate && pnpm build:web && wrangler dev",
    "prepack": "pnpm generate && pnpm build:skill",
    "test": "pnpm generate && vitest run",
    "types": "wrangler types"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@connectrpc/connect-web": "2.1.2",
    "@depot/connectrpc-workers": "2.0.0",
    "@pokertools/evaluator": "1.0.16",
    "hono": "^4.13.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.13.0",
    "@cloudflare/workers-types": "5.20260827.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.10",
    "wrangler": "4.127.0"
  },
  "packageManager": "pnpm@10.22.0"
}
